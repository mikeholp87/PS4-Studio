{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core window features plus the app's own explicitly listed commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-list-scenarios",
    "allow-connect-simulator",
    "allow-disconnect",
    "allow-get-connection",
    "allow-list-profiles",
    "allow-add-profile",
    "allow-delete-profile",
    "allow-get-setting",
    "allow-set-setting",
    "allow-list-audit",
    "allow-discover-lan",
    "allow-connect-profile",
    "allow-remote-play-status",
    "allow-start-remote-play",
    "allow-stop-remote-play",
    "allow-run-diagnostics",
    "allow-export-diagnostics",
    "allow-list-themes",
    "allow-save-theme",
    "allow-delete-theme",
    "allow-export-theme",
    "allow-import-theme",
    "allow-files-connect",
    "allow-files-disconnect",
    "allow-files-list-remote",
    "allow-files-list-local",
    "allow-files-set-write-lock",
    "allow-files-plan",
    "allow-files-apply",
    "allow-files-cancel",
    "allow-files-download",
    "allow-backup-create",
    "allow-backup-list",
    "allow-backup-verify",
    "allow-backup-delete",
    "allow-backup-restore-item",
    "allow-backup-save-item-as",
    "allow-hb-pick-and-scan",
    "allow-hb-verify",
    "allow-hb-upload-op",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}