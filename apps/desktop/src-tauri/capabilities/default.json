{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core window features plus the app's own explicitly listed commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-list-scenarios",
    "allow-connect-simulator",
    "allow-disconnect",
    "allow-get-connection",
    "allow-list-profiles",
    "allow-add-profile",
    "allow-delete-profile",
    "allow-get-setting",
    "allow-set-setting",
    "allow-list-audit"
  ]
}