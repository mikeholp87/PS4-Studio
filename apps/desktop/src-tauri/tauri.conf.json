{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PS4 Studio",
  "version": "0.1.0",
  "identifier": "org.ps4studio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "PS4 Studio", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"],
    "category": "Utility"
  }
}
